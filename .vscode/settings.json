{
    "latex-workshop.intellisense.package.enabled": true,
    "latex-workshop.intellisense.unimathsymbols.enabled": true,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.build.enableMagicComments": false,
    "latex-workshop.latex.recipe.default": "latexmk for bnuthesis",
    "latex-workshop.latex.search.rootFiles.include": [
        "bnuthesis-example.tex"
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk for bnuthesis",
            "tools": [
                "xetex-bnuthesis",
                "latexmk-xelatex"
            ]
        },
        {
            "name": "make thesis",
            "tools": [
                "make-thesis"
            ]
        },
        {
            "name": "latexmk for bnuthesis doc",
            "tools": [
                "xetex-bnuthesis",
                "latexmk-xelatex-bnuthesis"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xetex-bnuthesis",
            "command": "xetex",
            "args": [
                "-file-line-error",
                "-halt-on-error",
                "-interaction=batchmode",
                "%DIR%/bnuthesis.ins"
            ],
            "cwd": "%DIR%",
            "env": {}
        },
        {
            "name": "latexmk-xelatex",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-file-line-error",
                "-halt-on-error",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-pv-",
                "-pvc-",
                "-outdir=%OUTDIR%",
                "%DOC_EXT%"
            ],
            "cwd": "%DIR%",
            "env": {}
        },
        {
            "name": "latexmk-xelatex-bnuthesis",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-file-line-error",
                "-halt-on-error",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-pv-",
                "-pvc-",
                "-outdir=%OUTDIR%",
                "%DIR%/bnuthesis.dtx"
            ],
            "cwd": "%DIR%",
            "env": {}
        },
        {
            "name": "make-thesis",
            "command": "make",
            "args": [
                "thesis"
            ],
            "cwd": "%DIR%",
            "env": {}
        }
    ]
}
